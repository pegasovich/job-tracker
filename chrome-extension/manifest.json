{
  "manifest_version": 3,
  "name": "Job Apply AI Assistant (Gemini)",
  "version": "1.3.1",
  "description": "Автоматическая генерация откликов, ответов на анкеты и автозаполнение стандартных полей на разных сайтах",
  "permissions": [
    "storage",
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "https://generativelanguage.googleapis.com/*",
    "*://jobs.dou.ua/*",
    "*://*.dou.ua/*",
    "*://djinni.co/*",
    "*://*.linkedin.com/*",
    "*://*.robota.ua/*",
    "*://*.work.ua/*",
    "*://*.peopleforce.io/*",
    "*://*.greenhouse.io/*",
    "*://*.lever.co/*",
    "*://*.workable.com/*",
    "*://*.breezy.hr/*",
    "*://*.recruitee.com/*",
    "*://*.smartrecruiters.com/*"
  ],
  "optional_host_permissions": [
    "*://*/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "*://jobs.dou.ua/*",
        "*://*.dou.ua/*",
        "*://djinni.co/*",
        "*://*.linkedin.com/*",
        "*://*.robota.ua/*",
        "*://*.work.ua/*",
        "*://*.peopleforce.io/*",
        "*://*.greenhouse.io/*",
        "*://*.lever.co/*",
        "*://*.workable.com/*",
        "*://*.breezy.hr/*",
        "*://*.recruitee.com/*",
        "*://*.smartrecruiters.com/*"
      ],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
